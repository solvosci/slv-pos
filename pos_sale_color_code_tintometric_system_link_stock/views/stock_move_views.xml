<odoo>
    <record id="stock_move_form_view" model="ir.ui.view">
        <field name="name">stock.move.view.form (in pos_sale_color_code_tintometric_system_link_stock)</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="move_color_code_tintometric"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_search" model="ir.ui.view">
        <field name="name">stock.move.view.seach (in pos_sale_color_code_tintometric_system_link_stock)</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='by_product']" position="after">
                <filter string="Lot/S.Tin" name="by_lot" domain="[]" context="{'group_by': 'move_color_code_tintometric'}"/>
            </xpath>
        </field>
    </record>
</odoo>
