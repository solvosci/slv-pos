<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//table[@name='stock_move_line_table']//th[@name='th_sml_qty_ordered']" position="before">
            <t t-set="display_lot_stin" t-value="any(move.sudo().move_color_code_tintometric_pos for move in o.move_ids_without_package)"/>
            <t t-if="display_lot_stin">
                <th name="move_color_code_tintometric_pos"><strong>Lot/S.Tin</strong></th>
            </t>
        </xpath>
    </template>

    <!-- if product has serial number -->
    <template id="stock_report_delivery_has_serial_move_line" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//t[@name='move_line_lot']" position="before">
            <t t-set="display_lot_stin" t-value="any(move.sudo().move_color_code_tintometric_pos for move in o.move_ids_without_package)"/>
            <t t-if="display_lot_stin">
                <t t-if="move_line.move_id.move_color_code_tintometric_pos">
                    <td>
                        <span t-field="move_line.move_id.move_color_code_tintometric_pos"/>
                    </td>
                </t>
                <t t-else="">
                    <td>
                        <span></span>
                    </td>
                </t>
            </t>
        </xpath>
    </template>

    <template id="template_id" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="before">
            <t t-set="display_lot_stin" t-value="any(move.sudo().move_color_code_tintometric_pos for move in o.move_ids_without_package)"/>

            <t t-if="display_lot_stin">
                <t t-if="aggregated_lines[line].get('move_color_code_tintometric_pos')">
                    <td name="move_color_code_tintometric_pos">
                        <span t-esc="aggregated_lines[line].get('move_color_code_tintometric_pos')"/>
                    </td>
                </t>
                <t t-else="not aggregated_lines[line].get('move_color_code_tintometric_pos')">
                    <td name="move_color_code_tintometric_pos"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
