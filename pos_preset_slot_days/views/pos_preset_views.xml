<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_preset_form" model="ir.ui.view">
        <field name="name">pos.preset.form - pos_preset_slot_days</field>
        <field name="model">pos.preset</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_preset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='interval_time']]" position="after">
                <field name="slot_days" readonly="not use_timing"/>
            </xpath>
        </field>
    </record>
</odoo>
