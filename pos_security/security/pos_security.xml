<odoo>

    <data noupdate="0">
        <record id="group_super_admin_pos" model="res.groups">
            <field name="name">Super Admin</field>
            <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]" />
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="pos_payment_all_rule" model="ir.rule">
                <field name="name">POS super admin: manage all POS payment</field>
                <field name="model_id" ref="point_of_sale.model_pos_payment" />
                <field name="groups" eval="[(4, ref('group_super_admin_pos'))]" />
                <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="pos_payment_only_assigned_rule" model="ir.rule">
                <field name="name">POS payment: Only Assigned</field>
                <field name="model_id" ref="point_of_sale.model_pos_payment" />
                <field
                    name="domain_force"
                >["|", ("pos_order_id.config_id.basic_employee_ids.user_id.id", "=", user.id), ("pos_order_id.config_id.advanced_employee_ids.user_id.id", "=", user.id)]</field>
                <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]" />
                <field name="perm_read" eval="True" />
                <field name="perm_write" eval="True" />
                <field name="perm_unlink" eval="True" />
                <field name="perm_create" eval="True" />
        </record>

        <record id="pos_config_all_rule" model="ir.rule">
            <field name="name">POS super admin: manage all POS configs</field>
            <field name="model_id" ref="point_of_sale.model_pos_config" />
            <field name="groups" eval="[(4, ref('group_super_admin_pos'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="pos_config_only_assigned_rule" model="ir.rule">
            <field name="name"> POS config: Only Assigned</field>
            <field name="model_id" ref="point_of_sale.model_pos_config" />
            <field
                name="domain_force"
            >["|", ("basic_employee_ids.user_id.id", "=", user.id), ("advanced_employee_ids.user_id.id", "=", user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="perm_create" eval="True" />
        </record>

        <record id="pos_order_all_rule" model="ir.rule">
            <field name="name">POS super admin: manage all POS order</field>
            <field name="model_id" ref="point_of_sale.model_pos_order" />
            <field name="groups" eval="[(4, ref('group_super_admin_pos'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="pos_order_only_assigned_rule" model="ir.rule">
            <field name="name"> POS order: Only Assigned</field>
            <field name="model_id" ref="point_of_sale.model_pos_order" />
            <field
                name="domain_force"
            >["|", ("config_id.basic_employee_ids.user_id.id", "=", user.id), ("config_id.advanced_employee_ids.user_id.id", "=", user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="perm_create" eval="True" />
        </record>

        <record id="pos_order_line_all_rule" model="ir.rule">
            <field name="name">POS super admin: manage all POS order line</field>
            <field name="model_id" ref="point_of_sale.model_pos_order_line" />
            <field name="groups" eval="[(4, ref('group_super_admin_pos'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="pos_order_line_only_assigned_rule" model="ir.rule">
            <field name="name"> POS order line: Only Assigned</field>
            <field name="model_id" ref="point_of_sale.model_pos_order_line" />
            <field
                name="domain_force"
            >["|", ("order_id.config_id.basic_employee_ids.user_id.id", "=", user.id), ("order_id.config_id.advanced_employee_ids.user_id.id", "=", user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="perm_create" eval="True" />
        </record>

        <record id="pos_session_all_rule" model="ir.rule">
            <field name="name">POS super admin: manage all POS session</field>
            <field name="model_id" ref="point_of_sale.model_pos_session" />
            <field name="groups" eval="[(4, ref('group_super_admin_pos'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="pos_session_only_assigned_rule" model="ir.rule">
            <field name="name"> POS session: Only Assigned</field>
            <field name="model_id" ref="point_of_sale.model_pos_session" />
            <field
                name="domain_force"
            >["|", ("config_id.basic_employee_ids.user_id.id", "=", user.id), ("config_id.advanced_employee_ids.user_id.id", "=", user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="perm_create" eval="True" />
        </record>

        <record id="pos_order_report_all_rule" model="ir.rule">
            <field name="name">POS super admin: manage all POS order report</field>
            <field name="model_id" ref="point_of_sale.model_report_pos_order" />
            <field name="groups" eval="[(4, ref('group_super_admin_pos'))]" />
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="pos_order_report_only_assigned_rule" model="ir.rule">
            <field name="name"> POS order report: Only Assigned</field>
            <field name="model_id" ref="point_of_sale.model_report_pos_order" />
            <field
                name="domain_force"
            >["|", ("config_id.basic_employee_ids.user_id.id", "=", user.id), ("config_id.advanced_employee_ids.user_id.id", "=", user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]" />
            <field name="perm_read" eval="True" />
        </record>
    </data>

</odoo>
