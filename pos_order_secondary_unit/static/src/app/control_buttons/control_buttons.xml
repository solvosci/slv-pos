<templates id="template" xml:space="preserve">
    <t
        t-name="pos_order_secondary_unit.ControlButtons"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <!-- Main bar (desktop / large screens) -->
        <xpath expr="//SelectPartnerButton" position="after">
            <button
                t-if="!props.showRemainingButtons and secondaryUomLine"
                class="btn btn-secondary btn-lg o_secondary_uom_button text-truncate"
                t-on-click="() => this.onClickSecondaryUomQty()"
            >
                <i class="fa fa-cubes me-1" role="img" aria-label="Pieces" title="Pieces" />
                <t t-esc="secondaryUomLine.secondaryUomLabel or secondaryUomLine.productSecondaryUnit.name" />
            </button>
        </xpath>
        <!-- "More" dialog (small screens) -->
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/NoteButton" position="before">
            <button
                t-if="secondaryUomLine"
                class="o_secondary_uom_button"
                t-att-class="buttonClass"
                t-on-click="() => this.onClickSecondaryUomQty()"
            >
                <i class="fa fa-cubes me-1" role="img" aria-label="Pieces" title="Pieces" />
                Pieces
            </button>
        </xpath>
    </t>
</templates>
