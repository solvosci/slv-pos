<odoo>
    <record id="sale_order_tree" model="ir.ui.view">
        <field name="name">sale.order.tree (in sale_order_pos_transferred)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field
                    name="has_pos_orders"
                    widget="boolean_toggle"
                    optional="hide"                    
                    string="Transf. POS"
                    groups="point_of_sale.group_pos_user"
                />
            </field>
        </field>
    </record>
    
    <record id="view_sales_order_filter" model="ir.ui.view">
        <field name="name">sale.order.list.select (in sale_order_pos_transferred)</field>
        <field name="model">sale.order</field>
        <field
            name="inherit_id"
            ref="sale.view_sales_order_filter"
        />
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator groups="point_of_sale.group_pos_user"/>
                <filter
                    string="Transferred to POS"
                    name="transferred_to_pos"
                    domain="[('has_pos_orders', '=', True)]"
                    groups="point_of_sale.group_pos_user"
                />
            </filter>
        </field>
    </record>
</odoo>
