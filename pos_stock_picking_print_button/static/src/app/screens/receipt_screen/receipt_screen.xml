<templates id="template" xml:space="preserve">

    <t t-name="pos_stock_picking_print_button.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='printReceipt']" position="after">
            <button class="button print btn btn-lg btn-secondary w-100 py-3 mt-3" t-on-click="printStockPicking">
                <i class="fa fa-truck ms-2"></i> Print Picking
            </button>
        </xpath>
    </t>

</templates>
